# ====================================================================
# SpeakBack AI - Environment Configuration Template
# Copy this file to .env.local and populate with your project credentials.
# NEVER commit .env or .env.local to version control!
# ====================================================================

# --------------------------------------------------------------------
# Supabase Configuration (Authentication, Learning History & Admin RBAC)
# --------------------------------------------------------------------
# 1. Project URL and Public Anon Key (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# 2. Supabase Service Role Key (Server-side ONLY; NEVER expose with NEXT_PUBLIC_)
# Used exclusively for administrative operations, audit log recording, and account deletion
SUPABASE_SERVICE_ROLE_KEY=
# 3. Optional Admin Bootstrapping Secret
# If configured, used by POST /api/admin/bootstrap to promote the first admin.
# (Alternatively, promote the first admin via the SQL command in supabase/migrations/)
ADMIN_BOOTSTRAP_SECRET=

# --------------------------------------------------------------------
# AI Copilot Providers (viaSocket AI configured above; OpenAI optional)
# If left blank, SpeakBack AI runs in rich Demo Mode for testing and evaluation.
# --------------------------------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------------------------------
# AIGI Integration (Open Track)
# --------------------------------------------------------------------
AIGI_API_KEY=
AIGI_BASE_URL=
AIGI_MODEL=

# --------------------------------------------------------------------
# Voice Integrations (Wispr Flow & Smallest.ai)
# --------------------------------------------------------------------
WISPR_FLOW_API_KEY=
SMALLEST_API_KEY=

# --------------------------------------------------------------------
# viaSocket Integrations (Optional)
# --------------------------------------------------------------------
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
VIASOCKET_AGENT_TOKEN=
